# ---- EC2 settings: copy to .env on the instance ----
# No AWS keys here: the instance uses the Learner Lab LabRole (LabInstanceProfile).
MODE=aws
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,dogeusdt,adausdt,avaxusdt,linkusdt,pepeusdt
KAFKA=localhost:9092
AWS_DEFAULT_REGION=us-east-1

STORAGE=s3
BUCKET=cryptosentinel-xx-0000

NOTIFY=sns
SNS_TOPIC_ARN=

CRYPTOPANIC_URL=
CRYPTOPANIC_KEY=
