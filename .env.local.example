# ---- Laptop settings: copy to .env  (cp .env.local.example .env) ----
MODE=local
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,dogeusdt,adausdt,avaxusdt,linkusdt,pepeusdt
KAFKA=localhost:9092

# Data lake = a folder on your disk (mounted at /app/data)
STORAGE=local
LAKE_DIR=/app/data/lake

# DynamoDB Local accepts any keys; these are NOT real AWS credentials
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000

# Notifications printed in the logs instead of e-mail
NOTIFY=log

# News (leave empty to use RSS only)
CRYPTOPANIC_URL=
CRYPTOPANIC_KEY=
